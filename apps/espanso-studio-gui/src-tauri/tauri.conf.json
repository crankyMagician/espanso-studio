{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Espanso",
  "version": "0.1.0",
  "identifier": "com.crankymagician.espansostudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Espanso",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
